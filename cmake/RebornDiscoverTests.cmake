# =============================================================================
# Script mode (cmake -P), run after each build of a test executable.
#
#   -D TEST_EXECUTABLE=<path>  executable built on rb_test.h
#   -D OUTPUT_FILE=<path>      CTest file to write: one add_test() per test
# =============================================================================

execute_process(
    COMMAND "${TEST_EXECUTABLE}" --list
    OUTPUT_VARIABLE test_names
    ERROR_VARIABLE  list_error
    RESULT_VARIABLE list_result
)
if(NOT list_result EQUAL 0)
    # Fail the build: a stale list would silently run an old set of tests.
    message(FATAL_ERROR "${TEST_EXECUTABLE} --list failed (${list_result}):\n${test_names}${list_error}")
endif()

# Windows stdout is in text mode: lines end with \r\n.
string(REPLACE "\r" "" test_names "${test_names}")
string(REPLACE "\n" ";" test_names "${test_names}")

set(content "# Generated by RebornDiscoverTests.cmake - do not edit.\n")
foreach(name IN LISTS test_names)
    if(name STREQUAL "")
        continue()
    endif()
    # CTestTestfile syntax: add_test(<name> <command> <args>...).
    # Bracket arguments keep any character in a test name literal.
    string(APPEND content "add_test([==[${name}]==] [==[${TEST_EXECUTABLE}]==] --run [==[${name}]==])\n")
endforeach()

file(WRITE "${OUTPUT_FILE}" "${content}")
